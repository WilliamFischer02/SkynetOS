{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skynetos.local/schema/board.schema.json",
  "title": "SkynetOS Board",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "theme", "grid", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "name": { "type": "string" },
    "engraving": { "type": "string", "pattern": "^[A-Z0-9 ._-]{1,20}$" },
    "parent": { "type": ["string", "null"], "description": "Parent board id, null for root" },
    "theme": {
      "type": "object",
      "required": ["maskDark", "maskLight", "signal"],
      "additionalProperties": false,
      "properties": {
        "maskDark": { "$ref": "#/$defs/hex" },
        "maskLight": { "$ref": "#/$defs/hex" },
        "signal": { "$ref": "#/$defs/hex" },
        "substrateSeed": { "type": "integer" }
      }
    },
    "grid": {
      "type": "object",
      "required": ["tile", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "tile": { "const": 16 },
        "width": { "type": "integer", "minimum": 16, "maximum": 512, "description": "in tiles" },
        "height": { "type": "integer", "minimum": 16, "maximum": 512 }
      }
    },
    "agentEditPolicy": { "enum": ["require-approval", "auto"], "default": "require-approval" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "pos": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0, "description": "grid tiles from board origin" },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "name", "pos"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "designator": { "type": "string", "pattern": "^[A-Z]{1,2}[0-9]{1,3}$", "description": "U4, J2, D7 — auto-assigned per room" },
        "kind": {
          "enum": [
            "agent.code", "agent.chat", "agent.jarvis",
            "drive.room",
            "store.repo", "store.folder", "store.cloud",
            "file.document", "file.exe", "file.artifact",
            "link.url", "service.process", "task.scheduled",
            "monitor.system", "note.silk", "group.zone"
          ]
        },
        "name": { "type": "string", "maxLength": 40 },
        "pos": { "$ref": "#/$defs/pos" },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "w": { "type": "integer", "minimum": 1 }, "h": { "type": "integer", "minimum": 1 } },
          "description": "In tiles. Defaults per kind if omitted."
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "provisional": { "type": "boolean", "default": false, "description": "Unpopulated footprint — a TODO on the board" },
        "codexRef": { "type": "string", "description": "Path within codex/ describing this thing" },

        "cwd": { "type": "string" },
        "launch": { "enum": ["popout", "popout-elevated", "embedded", "headless"] },
        "model": { "type": "string" },
        "resume": { "type": "boolean", "default": true },
        "initialPrompt": { "type": "string" },
        "mcpServers": { "type": "array", "items": { "type": "string" } },

        "url": { "type": "string", "format": "uri" },
        "partition": { "type": "string" },
        "persona": { "type": "string" },

        "boardFile": { "type": "string", "description": "Relative path to the child board JSON" },
        "engraving": { "type": "string", "pattern": "^[A-Z0-9 ._-]{1,20}$" },

        "path": { "type": "string" },
        "localPath": { "type": "string" },
        "remote": { "type": "string" },
        "openWith": { "enum": ["explorer", "default", "browser", "terminal", "vscode"] },

        "glob": { "type": "string" },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "versionPattern": { "type": "string", "description": "Regex with one capture group for the version label" },

        "args": { "type": "array", "items": { "type": "string" } },
        "confirmBeforeLaunch": { "type": "boolean", "default": true },

        "startCommand": { "type": "string" },
        "port": { "type": "integer" },
        "healthUrl": { "type": "string" },

        "schedule": { "type": "string", "description": "cron expression" },
        "action": { "type": "object" },
        "enabled": { "type": "boolean", "default": true },

        "text": { "type": "string" },
        "size": { "enum": [11, 22] },
        "members": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "agent.code" } } }, "then": { "required": ["cwd", "launch"] } },
        { "if": { "properties": { "kind": { "const": "drive.room" } } }, "then": { "required": ["boardFile", "engraving"] } },
        { "if": { "properties": { "kind": { "const": "file.artifact" } } }, "then": { "required": ["glob"] } },
        { "if": { "properties": { "kind": { "enum": ["store.repo", "store.folder", "file.document", "file.exe"] } } }, "then": { "required": ["path"] } },
        { "if": { "properties": { "kind": { "enum": ["link.url", "store.cloud", "agent.chat", "agent.jarvis"] } } }, "then": { "required": ["url"] } },
        { "if": { "properties": { "kind": { "const": "service.process" } } }, "then": { "required": ["startCommand", "cwd"] } },
        { "if": { "properties": { "kind": { "const": "task.scheduled" } } }, "then": { "required": ["schedule", "action"] } },
        { "if": { "properties": { "kind": { "const": "note.silk" } } }, "then": { "required": ["text"] } }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": { "enum": ["produces", "reads", "depends", "deploys", "syncs", "supervises"] },
        "width": { "enum": [2, 3], "default": 2 },
        "waypoints": { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } },
        "label": { "type": "string", "maxLength": 24 }
      }
    }
  }
}
