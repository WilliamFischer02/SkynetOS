node_modules/
dist/
out/
release/
*.log
.DS_Store

# Machine-local runtime state — never commit
skynet.db
skynet.db-*
codex.db
codex.db-*
board/.snapshots/
.env
.env.*

# Asset working files (keep the exported PNGs, not the sources, unless you want history)
assets/sprites/**/*.aseprite

# Baked atlas — regenerated from assets/vendor + manifest.json by `npm run assets:bake`
assets/atlas/

# M0 smoke captures (regenerated by `npm run smoke`), per-agent capture folders, and the capture lock
.smoke/
.smoke*
.smoke.lock

# electron-builder output
release/

# Camera feasibility gate output (tools/camera-gate.mjs)
.camera-gate/

# Hand-tracking gate output (tools/gesture-gate.mjs)
.gesture-gate/

# Vision protocol probe scratch (tools/vision-protocol-probe.mjs)
.vision-probe/

# Private data home — finance ledgers, mail surveys, anything about William that is not code.
# The repo is public (docs/07); nothing under here may ever be committed.
private/

# JARVIS Prime's working files (prime/ itself is tracked)
prime/scratch/

# Voice recordings of William (JARVIS Voice profiles). Never committed: the repo is public.
voice-profiles/

# The Face's drops (codex/drops/): the record of what it sent, with William's own figures in it. Never published.
codex/drops/
# Schedule data: calendars, shifts, the week preview. Personal; scripts in schedule/ are tracked.
schedule/week.html
schedule/calendar.json
schedule/calendar.json.tmp
schedule/today.md
schedule/cache/
schedule/pbs-shifts.json
schedule/changes.log.jsonl
schedule/proposals.md
