      "readOnLaunch": [
        "codex/personas/finance-advisor.md",
        "codex/personas/jarvis-voice.md",
        "private/finance/README.md"
      ],
      "initialPrompt": "You are the finance advisor. Run `npm run finance:report` first, then read private/finance/report.json and ledger.json. State the position in four lines, list the alerts faults first, order the debts (avalanche and snowball, with the interest each costs per month), and end with one next action. Never invent a figure; never move money or log in anywhere; write only under private/finance/.",
      "tags": [
        "finance",
        "advisor"
      ],
      "frame": "castellated",
      "priority": 5,
      "showDesignator": false,
      "pulseGlow": true,
      "pulseColor": "ok",
      "notes": "The finance advisor. Persona: codex/personas/finance-advisor.md. Reads private/finance/ only."
    },
