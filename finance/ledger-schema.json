{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Shapes for the FinanceOS runtime files. ledger.jsonl is one JSON object per line matching #/$defs/ledgerEntry — the same shape as the Rent Run artifact's `ledger` collection, so the two can be reconciled. accounts.json matches #/$defs/accounts. settings.json matches #/$defs/settings. selections.json matches #/$defs/selections.",
  "$defs": {
    "ledgerEntry": {
      "type": "object",
      "required": ["date", "kind", "amount", "source"],
      "properties": {
        "id": {"type": "string"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "kind": {"enum": ["earn", "spend_work", "spend_personal", "card"]},
        "amount": {"type": "number", "minimum": 0},
        "hours": {"type": "number", "minimum": 0},
        "source": {"type": "string", "description": "options.json id (e.g. prolific-general-studie), or base-pbs, base-lyons, other, personal"},
        "note": {"type": "string", "maxLength": 200},
        "miles": {"type": "number", "minimum": 0, "description": "business miles for delivery/shoots"},
        "ts": {"type": "integer"}
      }
    },
    "accounts": {
      "type": "object",
      "required": ["fetched_at", "accounts"],
      "properties": {
        "fetched_at": {"type": "string", "format": "date-time"},
        "source": {"enum": ["simplefin", "bankbridge", "manual"]},
        "accounts": {"type": "array", "items": {
          "type": "object",
          "required": ["org", "name", "balance", "currency"],
          "properties": {
            "org": {"type": "string"}, "name": {"type": "string", "description": "label + last four only; never a full account number"},
            "kind": {"enum": ["checking", "savings", "credit", "brokerage", "crypto", "other"]},
            "currency": {"type": "string"}, "balance": {"type": "number"}, "available": {"type": ["number", "null"]},
            "balance_date": {"type": "string"}, "error": {"type": ["string", "null"]}
          }
        }}
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "goal": {"type": "number"}, "baseIncome": {"type": "number"}, "rent": {"type": "number"}, "subs": {"type": "number"},
        "food": {"type": "number"}, "other": {"type": "number"}, "cardBalance": {"type": "number"}, "cardApr": {"type": "number"},
        "cardMin": {"type": "number"}, "cardAsOf": {"type": "string"}, "streamMode": {"type": "boolean"},
        "taxSetAsidePct": {"type": "number", "default": 0.18}
      }
    },
    "selections": {
      "type": "object",
      "required": ["updated", "selections"],
      "properties": {
        "updated": {"type": "string"},
        "selections": {"type": "array", "items": {
          "type": "object",
          "required": ["option_id", "name", "lane", "status"],
          "properties": {
            "option_id": {"type": "string"}, "name": {"type": "string"}, "lane": {"type": "string"},
            "status": {"enum": ["selected", "parked", "applied", "active", "paused", "dropped"]},
            "dashboard_url": {"type": "string"}, "first_action": {"type": "string"}, "created": {"type": "string"}, "notes": {"type": "string"}
          }
        }}
      }
    }
  }
}
